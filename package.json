{
  "name": "seien",
  "version": "0.0.0",
  "private": true,
  "description": "A desktop avatar that asks you to do your tasks and cheers you on",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test tests/unit",
    "e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/bun": "1.4.5",
    "@types/node": "22.20.7",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "typescript": "7.0.2",
    "vite": "8.4.0"
  },
  "trustedDependencies": [
    "electron"
  ]
}
